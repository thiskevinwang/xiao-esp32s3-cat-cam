# XIAO ESP32S3 Sense: 8 MB QIO flash and 8 MB octal PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=40

# The USB-C connector becomes one UVC MJPEG camera after boot.
CONFIG_TUSB_MANUFACTURER="Cat Cam"
CONFIG_TUSB_PRODUCT="XIAO ESP32S3 Cat Cam"
CONFIG_TUSB_SERIAL_NUM="ALL-137"
CONFIG_FORMAT_MJPEG_CAM1=y
CONFIG_UVC_MODE_BULK_CAM1=y
# CONFIG_UVC_MODE_ISOC_CAM1 is not set
CONFIG_FRAMESIZE_QVGA=y
# CONFIG_FRAMESIZE_HD is not set
CONFIG_UVC_CAM1_FRAMERATE=5
# CONFIG_UVC_CAM1_MULTI_FRAMESIZE is not set
CONFIG_UVC_TINYUSB_TASK_CORE=0
CONFIG_UVC_CAM1_TASK_CORE=1

# Store only the fast 224 x 224 ESPDet-Pico cat model in flash.
CONFIG_FLASH_ESPDET_PICO_224_224_CAT=y
# CONFIG_FLASH_ESPDET_PICO_416_416_CAT is not set
CONFIG_ESPDET_PICO_224_224_CAT=y
CONFIG_CAT_DETECT_MODEL_IN_FLASH_RODATA=y

# USB OTG owns the native USB pins while the application runs.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
